{
  "artifactRoot": ".tt-local/artifacts",
  "storeRoot": ".tt-local/store",
  "paths": {
    "modelCache": "~/.cache/huggingface"
  },
  "evaluation": {
    "inference": {
      "device": "cuda",
      "maxNewTokens": 32,
      "temperature": 0,
      "topP": 1
    },
    "scoring": {
      "mode": "exact_match"
    },
    "generalRegression": {
      "dataset": "general-regression.jsonl",
      "maxScoreDrop": 0.03,
      "maxPassRateDrop": 0.05
    },
    "maxExamples": 2,
    "timeoutMs": 1800000
  }
}
